{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 26, "patch": 4 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimised, assertions disabled. The configuration that is installed.",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" }
  ]
}
